
<Project Sdk="Microsoft.NET.Sdk">

    <ItemGroup>
        <ProjectReference Include="..\Nase.Core\Nase.Core.csproj" />
        <ProjectReference Include="..\Nase.FrontEnd\Nase.FrontEnd.csproj" />
